<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title><%= $title %> - <%= $subtitle %></title>
  <meta name="description" content="Read the latest programming newsletter issues. Updated daily. No email needed.">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta property="og:title" content="<%= $title %>">
  <meta property="og:type" content="website">
  <meta property="og:description" content="Read the latest programming newsletter issues. Updated daily. No email needed.">
  <link rel="canonical" href="https://programmingnewsletters.com/">

  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161618" media="(prefers-color-scheme: dark)">

  <link rel="stylesheet" href="css/index.css">
  <link rel="manifest" href="site.webmanifest">
  <link rel="apple-touch-icon" href="icon.png">

  <noscript>
    <link rel="stylesheet" href="css/no-js.css">
  </noscript>

  <script src="javascript/main.js" defer></script>
</head>

<body>
  <div class="site">

    <header class="site-header">
      <div class="site-header__brand">
        <svg class="site-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 6L2 16L8 26" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24 6L30 16L24 26" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="12" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="12" y1="16" x2="20" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="12" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <div class="site-header__text">
          <h1 class="site-header__title">Programming Newsletters</h1>
          <p class="site-header__subtitle">Read the latest issues. No email needed.</p>
        </div>
      </div>
    </header>

    <nav class="filters" role="navigation" aria-label="Filter by category">
      <ul class="filters__list">
        <% foreach my $category (@{$categories}) { %>
          <li>
            <button class="filters__chip<%= $category eq 'All' ? ' filters__chip--active' : '' %>" type="button" data-category="<%= $category %>" aria-pressed="<%= $category eq 'All' ? 'true' : 'false' %>"><%= $category %></button>
          </li>
        <% } %>
      </ul>
    </nav>

    <p class="feed__status" aria-live="polite"><%= $current_sources %> current sources &middot; Generated <time datetime="<%= $generated_at %>"><%= $generated_at %></time></p>
    <main class="feed">
      <% foreach my $entry_group (@{$grouped_entries}) { %>
        <section class="feed__group">
          <h2 class="feed__date"><%= $entry_group->{date} %></h2>
          <ul class="feed__list">
            <% foreach my $entry (@{$entry_group->{entries}}) { %>
              <li class="feed__item" data-category="<%= $entry->{category} %>">
                <a href="<%= $entry->{url} %>" rel="nofollow noopener noreferrer" target="_blank" class="feed__link"><%= $entry->{name} %></a>
              </li>
            <% } %>
          </ul>
        </section>
      <% } %>
    </main>

    <footer class="site-footer">
      <p class="site-footer__text">
        &copy; <%= $year %> <%= $developer %> &middot;
        <a href="<%= $api_path %>" class="site-footer__link">API</a> &middot;
        <a href="<%= $source_url %>" class="site-footer__link">Source</a>
      </p>
    </footer>

  </div>
</body>

</html>
